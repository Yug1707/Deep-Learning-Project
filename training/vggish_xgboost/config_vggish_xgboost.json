{
  "seed": 42,
  "paths": {
    "audio_dir": "fma_small",
    "metadata_csv": "fma_metadata/tracks.csv",
    "output_root": "logs/vggish_xgboost",
    "embeddings_dir": "logs/vggish_xgboost/embeddings",
    "models_dir": "logs/vggish_xgboost/models",
    "results_dir": "logs/vggish_xgboost/results"
  },
  "dataset": {
    "subset": "small",
    "top_k_genres": 8,
    "train_size": 0.7,
    "val_size": 0.15,
    "test_size": 0.15,
    "min_audio_seconds": 2.0,
    "balancing": {
      "enabled": true,
      "mode": "cap_to_min_positive"
    }
  },
  "audio": {
    "sample_rate": 16000,
    "mono": true,
    "res_type": "soxr_hq"
  },
  "vggish": {
    "device": "auto",
    "pooling": "mean"
  },
  "xgboost": {
    "n_estimators": 300,
    "max_depth": 6,
    "learning_rate": 0.05,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "reg_lambda": 1.0,
    "min_child_weight": 1,
    "random_state": 42,
    "n_jobs": -1,
    "eval_metric": "logloss"
  },
  "evaluation": {
    "threshold": 0.5
  }
}
